# Wajib untuk pemeriksaan nyata. Gunakan email aktif untuk Crossref polite pool.
CROSSREF_MAILTO=nama@example.com

# Endpoint kompatibel OpenAI Chat Completions (tanpa /chat/completions).
# Verifikasi base URL dan nama model pada dokumentasi resmi provider Anda.
# Contoh Groq: https://api.groq.com/openai/v1
# Contoh Ollama: http://localhost:11434/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=isi_api_key_anda
LLM_MODEL=llama-3.3-70b-versatile

# Opsional: demo dapat dipakai tanpa konfigurasi di atas.
NEXT_PUBLIC_DEMO_MODE=true
